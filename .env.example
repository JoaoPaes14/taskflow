# TaskFlow - variáveis de ambiente obrigatórias
# Copie para .env e preencha antes de rodar:  cp .env.example .env
# Todos os secrets abaixo são exigidos pelo docker-compose (:? no compose).

# MySQL - senha do root (obrigatório)
MYSQL_ROOT_PASSWORD=

# Nome do banco de dados (default: taskflow)
MYSQL_DATABASE=taskflow

# JWT - chave de assinatura (obrigatório)
# Gere uma chave forte com:  openssl rand -base64 48
JWT_SECRET=

# JWT - expiração em milissegundos (default: 1 dia)
JWT_EXPIRATION=86400000

# E-mail (opcional - usados pelos schedulers de notificacao e daily summary)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true